# Copia estas variables en Vercel (Settings > Environment Variables).
# Si conectas Supabase desde la integración de Vercel, las tres primeras se crean solas.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Opcional: la dirección pública de la app, para armar los enlaces de invitación.
APP_URL=https://tu-app.vercel.app
